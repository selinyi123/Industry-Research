{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industry-research.local/spec/research-run.schema.json",
  "title": "ResearchRun",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "target", "status", "started_at", "search_modes", "evidence_gap_ids"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "parent_run_id": {"type": ["string", "null"]},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["industry"],
      "properties": {
        "industry": {"type": "string", "minLength": 1},
        "geography": {"type": ["string", "null"]},
        "time_horizon": {"type": ["string", "null"]},
        "decision_context": {"type": ["string", "null"]}
      }
    },
    "status": {
      "type": "string",
      "enum": ["planned", "running", "saturated", "completed", "partial", "failed", "cancelled"]
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "search_modes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "discovery",
          "authority",
          "report",
          "data",
          "regional_local_language",
          "company_value_chain",
          "contradiction",
          "citation_chasing",
          "gap",
          "saturation_test"
        ]
      },
      "uniqueItems": true
    },
    "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "document_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "metric_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "conflict_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_gap_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "stop_reason": {"type": ["string", "null"]},
    "material_delta": {"type": "boolean"}
  }
}
